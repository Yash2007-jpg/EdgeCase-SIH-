# Copy this file to .env and fill in real values.
# Never commit the real .env file or share these values with the frontend.

# Postgres connection string (must have pgvector installed, with the
# chunks/embeddings tables already populated).
DATABASE_URL=postgresql://user:password@localhost:5432/manak_mitra

# Groq API key used server-side only by generator.py. Must never be
# exposed to the React frontend.
GROQ_API_KEY=your-groq-api-key-here
